      }

      .link-url {
        font-size: 21px;
        color: white;
      }

      .contact-section-8 {
        width: 100%;
        height: 70px;
        text-align: center;
        color: white;
        font-size: 21px;
        line-height: 26px;
      }

      /* ====================================
         PRINT OPTIMIZATION
