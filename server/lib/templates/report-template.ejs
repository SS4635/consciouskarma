        border: 2px solid #ffffff;
        border-radius: 10px;
        width: 90%;
        height: 7%;
        max-width:480px;
        padding: 10px 0px;
        display: flex;
        justify-content: center;
        margin: 30px 0px;
      }

      .influence-title-text {
        font-size: 30px;
        font-weight: 400;
        color: #ffffff;
        
      }

      .influence-content {
        width: 100%;
        height: 93%;
        display: flex;
        flex-direction: column;
        justify-content: start;
        align-items: center;
        /* border:2px solid green; */
