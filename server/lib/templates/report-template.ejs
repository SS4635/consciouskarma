        height: 100%;
        width: 100%;
        color: #ffffff;
        text-align: left;
        line-height: 1.2;
        /* border: 2px solid yellow; */
        
      }

      .report-title {
        font-size: 32px !important;
        font-weight: 400;
        text-align: center;
        /* text-decoration: underline; */
        margin-top: 30px;
        margin-bottom: 30px !important;
        letter-spacing: 0px !important;
        /* border: 2px solid green; */
      }

      .report-section p {
        margin-bottom: 15px;
        font-size: 24px;
